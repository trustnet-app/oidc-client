# Production — copy to .env.production and fill in the client credentials.
# Run with: ./run production
WELL_KNOWN_URL=https://id.trustnet.app/.well-known/openid-configuration

CLIENT_ID=change-me
CLIENT_SECRET=change-me
REDIRECT_URI=http://localhost:5556/callback

LISTEN=:5556
LABEL=production RP

# TrustNet machine plane (optional).
MACHINE_URL=https://rp.trustnet.app
JWKS_URL=https://rp.trustnet.app/api/v1/webhook/jwks
