# Production — copy to .env.production and fill in the client credentials.
# Run with: ./run production
WELL_KNOWN_URL=https://id.trustnet.app/.well-known/openid-configuration

CLIENT_ID=change-me
CLIENT_SECRET=change-me
REDIRECT_URI=http://localhost:5556/redirect

# Match the client's registered token_endpoint_auth_method (post|basic).
# RPs registered through the production portal default to client_secret_basic.
TOKEN_AUTH_METHOD=basic

LISTEN=:5556
LABEL=production RP

# Demo persistence (SQLite). Put DB_PATH on a persistent volume.
DB_PATH=demo-rp.db
SESSION_TTL=1h
# Public HTTPS deployment: keep cookies Secure.
COOKIE_SECURE=true
PURGE_STRICT=true

# TrustNet machine plane (optional).
MACHINE_URL=https://rp.trustnet.app
JWKS_URL=https://rp.trustnet.app/api/v1/webhook/jwks
