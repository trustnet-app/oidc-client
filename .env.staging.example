# Staging — copy to .env.staging and fill in the client credentials.
# Run with: ./run.sh staging
WELL_KNOWN_URL=https://id.stg.trustnet.test/.well-known/openid-configuration

CLIENT_ID=change-me
CLIENT_SECRET=change-me
REDIRECT_URI=http://localhost:5556/redirect

# Match the client's registered token_endpoint_auth_method (post|basic).
TOKEN_AUTH_METHOD=basic

LISTEN=:5556
LABEL=staging RP

# Demo persistence (SQLite). All demo state expires after SESSION_TTL.
# DB_PATH=demo-rp.db
# SESSION_TTL=1h
# COOKIE_SECURE=true when served over HTTPS.
# COOKIE_SECURE=false
# PURGE_STRICT=true

# TrustNet machine plane (optional).
MACHINE_URL=https://rp.stg.trustnet.test
JWKS_URL=https://rp.stg.trustnet.test/api/v1/webhook/jwks

# Local staging serves an internal CA — trust its root explicitly.
# CA_FILE=/path/to/caddy-root-ca.pem
# TLS_INSECURE=false
