# OIDC discovery document for the target environment.
WELL_KNOWN_URL=https://id.stg.trustnet.test/.well-known/openid-configuration
# Or, equivalently, an issuer origin:
# ISSUER=https://id.stg.trustnet.test

# RP client registered in that environment (client_secret_post).
CLIENT_ID=staging-demo-rp
CLIENT_SECRET=change-me

# Must be registered as a redirect URI on the client above.
REDIRECT_URI=http://localhost:5556/callback

# How the client authenticates at the token endpoint: post (default) or basic.
# Must match the client's registered token_endpoint_auth_method.
# TOKEN_AUTH_METHOD=post

# Local listen address and the label shown on screen / in /debug/state.
LISTEN=:5556
LABEL=staging RP

# Optional TrustNet machine plane (NOT part of OIDC discovery).
# Setting MACHINE_URL enables the machine-plane /userinfo probe on the result page.
# MACHINE_URL=https://rp.stg.trustnet.test
# Setting JWKS_URL enables purge-webhook JWS verification on POST /purge.
# JWKS_URL=https://rp.stg.trustnet.test/api/v1/webhook/jwks

# Staging uses an internal CA: point CA_FILE at its PEM root.
# TLS_INSECURE=true is a dev-only escape hatch and warns loudly.
# CA_FILE=/path/to/caddy-root-ca.pem
# TLS_INSECURE=false
